<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>CyberHub — About Us</title>

<!-- Bootstrap CSS -->
<link href="https://cdnjs.cloudflare.com/ajax/libs/bootstrap/5.3.3/css/bootstrap.min.css" rel="stylesheet">

<!-- Fonts -->
<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@400;500;700&family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">

<style>
  :root{
    --bg:        #0A0E17;
    --surface:   #11172A;
    --surface-2: #161D33;
    --border:    #232C45;
    --text:      #E7ECF6;
    --text-muted:#7C88A6;
    --cyan:      #45D9E0;
    --amber:     #F2A93B;
  }

  *{ box-sizing:border-box; }

  body{
    background:var(--bg);
    color:var(--text);
    font-family:'Inter', sans-serif;
    margin:0;
    min-height:100vh;
    display:flex;
    flex-direction:column;
  }

  a{ color:inherit; text-decoration:none; }

  /* Navbar */
  .nav-bar{
    background:var(--surface);
    border-bottom:1px solid var(--border);
    padding:14px 28px;
    display:flex;
    align-items:center;
    justify-content:space-between;
    flex-wrap:wrap;
    gap:12px;
    position:sticky;
    top:0;
    z-index:50;
  }
  .brand{
    display:flex;
    align-items:center;
    gap:10px;
    font-family:'JetBrains Mono', monospace;
    font-weight:700;
    font-size:18px;
  }
  .brand .bracket{ color:var(--cyan); }
  .nav-links{ display:flex; gap:24px; align-items:center; }
  .nav-links a{
    font-size:14px;
    color:var(--text-muted);
    font-weight:500;
    transition:color .15s;
  }
  .nav-links a:hover, .nav-links a.active{ color:var(--text); }

  /* Page Layout */
  .about-container{
    max-width:1000px;
    margin:40px auto 80px;
    padding:0 20px;
    flex-grow:1;
    width:100%;
  }

  .page-title{
    text-align:center;
    font-family:'JetBrains Mono', monospace;
    font-size:26px;
    color:var(--cyan);
    margin-bottom:8px;
  }

  .page-subtitle{
    text-align:center;
    color:var(--text-muted);
    font-size:14px;
    margin-bottom:60px;
  }

  /* Staggered Team Grid Layout */
  .team-grid{
    display:grid;
    grid-template-columns:repeat(3, 1fr);
    gap:20px;
    align-items:start;
    position:relative;
  }

  /* Middle card raised higher to start side cards at its half-height */
  .member-card.middle{
    transform:translateY(-40px);
  }

  .member-card{
    background:var(--surface);
    border:1px solid var(--border);
    border-radius:12px;
    padding:20px;
    text-align:center;
    transition:transform .18s ease, border-color .18s ease;
  }

  .member-card:hover{
    border-color:var(--cyan);
  }

  .member-card.middle:hover{
    transform:translateY(-45px);
  }

  .avatar-wrap{
    width:120px;
    height:120px;
    margin:0 auto 16px;
    border-radius:50%;
    overflow:hidden;
    border:2px solid var(--cyan);
    background:var(--surface-2);
  }

  .avatar-wrap img{
    width:100%;
    height:100%;
    object-fit:cover;
  }

  .member-name{
    font-family:'JetBrains Mono', monospace;
    font-size:16px;
    font-weight:700;
    color:var(--text);
    margin-bottom:6px;
  }

  .member-uni{
    font-size:13px;
    color:var(--text-muted);
    line-height:1.4;
  }

  /* Responsive stacking for smaller screens */
  @media (max-width: 768px) {
    .team-grid{
      grid-template-columns:1fr;
      gap:30px;
    }
    .member-card.middle{
      transform:none;
    }
    .member-card.middle:hover{
      transform:none;
    }
  }

  footer{
    border-top:1px solid var(--border);
    padding:18px 28px;
    text-align:center;
    font-family:'JetBrains Mono', monospace;
    font-size:12px;
    color:var(--text-muted);
  }
</style>
</head>
<body>

<!-- Navbar -->
<nav class="nav-bar">
  <div class="brand">
    <span class="bracket">[</span> cyberhub <span class="bracket">]</span>
  </div>
  <div class="nav-links">
    <a href="cyberhub.html">Home</a>
    <a href="signup.html">Sign Up</a>
    <a href="contact.html">Contact</a>
    <a href="about.html" class="active">About Us</a>
  </div>
</nav>

<!-- Main Section -->
<div class="about-container">
  <h1 class="page-title"> Eagle Eye</h1>
  <p class="page-subtitle">Meet the team behind CyberHub</p>

  <div class="team-grid">
    <!-- Creator 1 (Left) -->
    <div class="member-card left">
      <div class="avatar-wrap">
        <img src="shawon.jpg" alt="Creator 1">
      </div>
      <div class="member-name">Atik Shahriar</div>
      <div class="member-uni">International Islamic University Chittagong</div>
    </div>

    <!-- Creator 2 (Middle - Elevated) -->
    <div class="member-card middle">
      <div class="avatar-wrap">
        <img src="samir.jpg" alt="Creator 2">
      </div>
      <div class="member-name">Adnan Shamir</div>
      <div class="member-uni">International Islamic University Chittagong</div>
    </div>

    <!-- Creator 3 (Right) -->
    <div class="member-card right">
      <div class="avatar-wrap">
        <img src="tajri.jpeg" alt="Creator 3">
      </div>
      <div class="member-name">MD Ashrarul</div>
      <div class="member-uni">International Islamic University Chittagong</div>
    </div>
  </div>
</div>

<footer>// CyberHub — created by students, for students</footer>

</body>
</html>
