<style>
  :root{
    --bg:        #0A0E17;
    --surface:   #11172A;
    --surface-2: #161D33;
    --border:    #232C45;
    --text:      #E7ECF6;
    --text-muted:#7C88A6;
    --cyan:      #45D9E0;
    --amber:     #F2A93B;
  }

  *{ box-sizing:border-box; }

  body{
    background:var(--bg);
    color:var(--text);
    font-family:'Inter', sans-serif;
    margin:0;
    min-height:100vh;
  }

  a{ color:inherit; text-decoration:none; }

  .mono{ font-family:'JetBrains Mono', monospace; }

  /* ---------- NAVBAR ---------- */
  .nav-bar{
    background:var(--surface);
    border-bottom:1px solid var(--border);
    padding:14px 28px;
    display:flex;
    align-items:center;
    justify-content:space-between;
    flex-wrap:wrap;
    gap:12px;
    position:sticky;
    top:0;
    z-index:50;
  }
  .brand{
    display:flex;
    align-items:center;
    gap:10px;
    font-family:'JetBrains Mono', monospace;
    font-weight:700;
    font-size:18px;
    letter-spacing:.02em;
  }
  .brand .bracket{ color:var(--cyan); }
  .led{
    width:8px; height:8px; border-radius:50%;
    background:var(--amber);
    box-shadow:0 0 8px var(--amber);
    animation:blink 1.6s ease-in-out infinite;
  }
  @keyframes blink{ 0%,100%{opacity:1;} 50%{opacity:.25;} }

  .nav-links{ display:flex; gap:24px; align-items:center; }
  .nav-links a{
    font-size:14px;
    color:var(--text-muted);
    font-weight:500;
    transition:color .15s;
  }
  .nav-links a:hover{ color:var(--text); }
  .nav-links a.disabled{
    cursor:default;
    position:relative;
  }
  .nav-links a.disabled:hover::after{
    content:"Coming soon";
    position:absolute;
    top:130%; left:50%;
    transform:translateX(-50%);
    background:var(--surface-2);
    border:1px solid var(--border);
    color:var(--text-muted);
    font-size:11px;
    padding:4px 8px;
    border-radius:6px;
    white-space:nowrap;
  }

  /* ---------- FILTER BAR ---------- */
  .filter-section{
    background:var(--surface);
    border-bottom:1px solid var(--border);
    padding:16px 28px 18px;
  }
  .filter-row{
    display:flex;
    gap:10px;
    flex-wrap:wrap;
  }
  .filter-pill{
    font-family:'JetBrains Mono', monospace;
    background:transparent;
    border:1px solid var(--border);
    color:var(--text-muted);
    padding:7px 16px;
    border-radius:999px;
    font-size:13px;
    cursor:pointer;
    transition:all .15s ease;
  }
  .filter-pill:hover{ border-color:var(--cyan); color:var(--text); }
  .filter-pill.active{
    background:var(--cyan);
    border-color:var(--cyan);
    color:#04141A;
    font-weight:600;
    box-shadow:0 0 16px rgba(69,217,224,.35);
  }

  /* Terminal status line — reflects whatever filter is active */
  .terminal-line{
    margin-top:14px;
    font-family:'JetBrains Mono', monospace;
    font-size:13px;
    color:var(--text-muted);
  }
  .terminal-line .prompt-user{ color:var(--cyan); }
  .terminal-line .prompt-tilde{ color:var(--text-muted); }
  .terminal-line #commandText{ color:var(--text); }
  .cursor-blink{
    display:inline-block;
    color:var(--amber);
    animation:blink 1s steps(1) infinite;
  }
  .result-count{
    margin-top:4px;
    font-family:'JetBrains Mono', monospace;
    font-size:12px;
    color:var(--text-muted);
  }

  /* ---------- RESOURCE GRID ---------- */
  .grid-wrap{ padding:28px; max-width:1400px; margin:0 auto; }

  .resource-grid{
    display:grid;
    grid-template-columns:repeat(auto-fill, minmax(230px, 1fr));
    gap:20px;
  }

  .resource-card{
    background:var(--surface);
    border:1px solid var(--border);
    border-radius:12px;
    overflow:hidden;
    cursor:pointer;
    transition:transform .18s ease, box-shadow .18s ease, border-color .18s ease;
    display:flex;
    flex-direction:column;
  }
  .resource-card:hover{
    transform:translateY(-5px);
    border-color:var(--cyan);
    box-shadow:0 10px 28px rgba(0,0,0,.45);
  }
  .resource-card img{
    width:100%;
    aspect-ratio:16/9;
    object-fit:cover;
    display:block;
    background:var(--surface-2);
  }
  .resource-card .card-body{ padding:14px 16px 16px; }
  .resource-card .tag{
    font-family:'JetBrains Mono', monospace;
    font-size:10.5px;
    letter-spacing:.06em;
    text-transform:uppercase;
    color:var(--amber);
  }
  .resource-card h3{
    font-size:14.5px;
    font-weight:600;
    line-height:1.35;
    margin:6px 0 0;
    color:var(--text);
  }

  /* ---------- EMPTY STATE ---------- */
  .empty-state{
    border:1px dashed var(--border);
    border-radius:12px;
    padding:28px 24px;
    font-family:'JetBrains Mono', monospace;
    font-size:13px;
    grid-column:1 / -1;
  }
  .empty-state p{ margin:0 0 6px; }
  .empty-state .live{ color:var(--text); }
  .empty-state .muted{ color:var(--text-muted); }

  footer{
    border-top:1px solid var(--border);
    padding:18px 28px;
    text-align:center;
    font-family:'JetBrains Mono', monospace;
    font-size:12px;
    color:var(--text-muted);
  }
</style>
</head>
