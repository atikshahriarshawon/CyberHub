    if (resource.type === "youtube") {
      const id = getYouTubeId(resource.url);
      return id ? `https://img.youtube.com/vi/${id}/hqdefault.jpg` : FALLBACK_THUMB;
    }
    return resource.thumbnail || FALLBACK_THUMB;
  }

  // Fisher–Yates shuffle (returns a new array, doesn't mutate the original).
  function shuffle(arr) {
    const a = arr.slice();
    for (let i = a.length - 1; i > 0; i--) {
      const j = Math.floor(Math.random() * (i + 1));
      [a[i], a[j]] = [a[j], a[i]];
    }
    return a;
  }

  function randomInt(min, max) {
    return Math.floor(Math.random() * (max - min + 1)) + min;
  }

  function buildCard(resource) {
    const card = document.createElement("div");
    card.className = "resource-card";
    card.innerHTML = `
      <img src="${getThumbnail(resource)}" alt="${resource.title}" loading="lazy">
      <div class="card-body">
        <div class="tag">${CATEGORY_LABELS[resource.category] || resource.category}</div>
        <h3>${resource.title}</h3>
      </div>
    `;
    card.addEventListener("click", () => window.open(resource.url, "_blank", "noopener"));
    return card;
  }

  function buildEmptyState(category) {
    const wrap = document.createElement("div");
    wrap.className = "empty-state";
    wrap.innerHTML = `
      <p class="live">$ query --category=${category} --status</p>
      <p class="muted"># 0 resources found</p>
      <p class="muted"># add an entry to the RESOURCES array (top of the script) tagged "${category}" to populate this section</p>
    `;
    return wrap;
  }

  function render(category) {
    const grid = document.getElementById("resourceGrid");
    const commandText = document.getElementById("commandText");
    const resultCount = document.getElementById("resultCount");
    grid.innerHTML = "";

    let list;
    if (category === "all") {
      const count = Math.min(RESOURCES.length, randomInt(20, 30));
      list = shuffle(RESOURCES).slice(0, count);
      if (commandText) commandText.textContent = ` filter --category=all --limit=${count} --shuffle`;
    } else {
      list = RESOURCES.filter(r => r.category === category);
      if (commandText) commandText.textContent = ` filter --category=${category} --show=all`;
    }

    if (list.length === 0) {
      grid.appendChild(buildEmptyState(category));
      resultCount.textContent = `# 0 results`;
      return;
    }

    list.forEach(r => grid.appendChild(buildCard(r)));
    resultCount.textContent = `# ${list.length} result${list.length !== 1 ? "s" : ""}`;
  }

  // Wire up filter buttons.
  document.querySelectorAll(".filter-pill").forEach(btn => {
    btn.addEventListener("click", () => {
      document.querySelectorAll(".filter-pill").forEach(b => b.classList.remove("active"));
      btn.classList.add("active");
      render(btn.dataset.category);
    });
  });

  // Initial render — re-shuffles every time the page loads.
  render("all");
</script>
</body>
</html>
