  // Pull a YouTube video ID out of any common YouTube URL shape.
  function getYouTubeId(url) {
    try {
      const u = new URL(url);
      if (u.hostname.includes("youtu.be")) return u.pathname.slice(1);
      if (u.searchParams.get("v")) return u.searchParams.get("v");
      return null;
    } catch (e) {
      return null;
    }
  }

